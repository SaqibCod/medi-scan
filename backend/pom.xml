<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>medi-scan</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>medi-scan-backend</name>
	<description>Explains medical lab reports in plain language</description>

	<properties>
		<!--
		  Java 21 per docs/plan.md section 2. Boot's parent turns this into
		  maven.compiler.release, so a newer local JDK still produces Java 21
		  bytecode; the Docker image runs a real JDK 21.
		-->
		<java.version>21</java.version>

		<!--
		  Spring AI 2.0.x supports Spring Boot 4.0.x and 4.1.x, so 2.0.1 pairs
		  with the 4.1.1 parent above. Imported as a BOM only - no Spring AI
		  starter is added until phase 2, which is where the first model call
		  lives. See docs/plan.md section 14.
		-->
		<spring-ai.version>2.0.1</spring-ai.version>

		<!--
		  Bucket4j's maintained line is the JDK-specific artifact; the plain
		  `bucket4j-core` coordinate stopped at 8.10.1.
		-->
		<bucket4j.version>8.21.0</bucket4j.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!--
		  spring-boot-starter-webmvc, not spring-boot-starter-web: the latter is
		  deprecated in Boot 4 in favour of this one.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Phase 1 uses one stateless filter chain with a guest-token filter. The
		  bearer-token resource server (spring-boot-starter-oauth2-resource-server)
		  arrives in phase 6 - see SecurityConfig.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
		  Flyway owns the schema; versions come from Boot's dependency management.

		  The starter, not a bare flyway-core: Boot 4 split autoconfiguration into
		  per-technology modules, so flyway-core on its own gives you the library
		  with nothing wired up. Migrations then never run, and the first symptom
		  is Hibernate failing schema validation on a missing table rather than
		  anything mentioning Flyway. The starter pulls in flyway-core itself.

		  flyway-database-postgresql is still needed explicitly: Flyway 10+ ships
		  each database's support as its own artifact.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Rate limiting: per IP, or per user once sign-in exists (plan section 5). -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-core</artifactId>
			<version>${bucket4j.version}</version>
		</dependency>

		<!-- Boot 4's granular test starters, in place of spring-boot-starter-test. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  Tests run against real Postgres with pgvector, not H2, so migrations and
		  the vector extension are exercised. Testcontainers 2.x renamed every
		  module to a `testcontainers-` prefix and moved PostgreSQLContainer to
		  org.testcontainers.postgresql.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
