# Medi-Scan configuration
#
# Copy to `.env` and fill in. Never commit `.env`.
# The variables here are exactly those defined in docs/plan.md section 10.
#
# Phase 1 (foundation) only reads DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD
# and ALLOWED_ORIGIN. The rest are declared now so the file matches the design
# doc, and are picked up by the phase that needs them.

# --- LLM provider (phase 2) ---
LLM_PROVIDER=gemini                # gemini | openai
GEMINI_API_KEY=
# The pipeline model: extraction and the summary. Leave these at the defaults
# unless you have measured a replacement — a Flash model that answers a models
# listing can still refuse every generation call, which is how gemini-3.8-flash
# and gemini-flash-latest (its alias) stopped working. See the comment on
# mediscan.llm.model in backend/src/main/resources/application.yml.
GEMINI_CHAT_MODEL=gemini-3.6-flash
# The chat model (phase 5), deliberately separate so that choosing one does not
# move the model the phase 3 extraction baseline was measured against.
CHAT_MODEL=gemini-3.6-flash
OPENAI_API_KEY=                    # optional, leave empty to disable
OPENAI_CHAT_MODEL=gpt-5-mini

# --- Embeddings (phase 5) ---
# Fixed once chosen: changing the model means re-embedding every biomarker page
# and migrating the pgvector column. EMBEDDING_DIMENSIONS must match that column.
EMBEDDING_PROVIDER=gemini          # fixed once chosen
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768           # must match the pgvector column

# --- RAG over the biomarker pages (phase 5) ---
# true indexes only pages with `reviewedOn` set, so unreviewed medical text never
# reaches a live answer. The prod profile defaults to true and local to false —
# nothing is reviewed yet, and local needs an index to answer general questions.
RAG_REQUIRE_REVIEWED=false

# --- Database ---
# Port 5433, not the default 5432: the local compose file publishes there so it
# does not collide with a natively installed Postgres.
DATABASE_URL=jdbc:postgresql://localhost:5433/mediscan
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- CORS ---
ALLOWED_ORIGIN=http://localhost:3000

# --- Limits and cost control ---
RATE_LIMIT_UPLOADS_PER_HOUR=10
# Per IP, for POST /api/sessions (contract 1.6). Read by phase 1.
RATE_LIMIT_SESSIONS_PER_HOUR=20
# Per user when signed in, otherwise per IP, for POST /api/reports/{id}/chat
# (contract 1.6). Read by phase 5.
RATE_LIMIT_CHAT_PER_HOUR=30
# Every uncached chat answer costs 2 of these: one embedding call and one model call.
# A cache hit costs none.
GLOBAL_DAILY_LLM_CALLS=500

# --- Uploads (phase 2) ---
# Directory for upload temp files, created at startup with owner-only permissions.
# Leave blank to use the default under the system temp directory.
UPLOAD_TEMP_DIR=

# --- OCR (phase 4) ---
# Photos and scanned PDF pages are read by running the `tesseract` program as a child
# process. Set OCR_ENABLED=false to reject images with 415 and skip the scanned-page
# fallback; the local profile also turns itself off with a WARN when tesseract is missing,
# while the prod profile refuses to start.
OCR_ENABLED=true
OCR_COMMAND=tesseract              # path to the tesseract program
# Blank uses the system tessdata. Set this to the directory holding a tessdata_best
# `eng.traineddata` to use the slower, more accurate model.
OCR_TESSDATA_DIR=
# Tesseract page segmentation mode. 4 ("a single column of variable-sized text") suits
# lab tables; the evaluation run picks the final value.
OCR_PSM=4

# --- Retention ---
RETENTION_HOURS=24                 # guest sessions
USER_RETENTION_DAYS=30             # signed-in users' reports
INACTIVE_ACCOUNT_DAYS=180

# --- Google sign-in (phase 6a) ---
# Required in the prod profile. Left blank in local, Google sign-in is disabled
# and POST /api/auth/google always answers GOOGLE_TOKEN_INVALID.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com   # public, not a secret

# --- Access and refresh tokens (phase 6a) ---
# Generate each key with: openssl rand -base64 32
# Never reuse a key between local and production.
JWT_SIGNING_KEYS=k2026a:REPLACE_WITH_BASE64_32_BYTES   # comma-separated kid:key pairs
JWT_CURRENT_KID=k2026a
JWT_ISSUER=medi-scan
# The `aud` claim on access tokens, which the resource server verifies (contract 2.3).
JWT_AUDIENCE=medi-scan-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_FAMILY_MAX_DAYS=30

# --- Admin (phase 6a) ---
# Comma-separated Google `sub` ids. This is the only way to grant ADMIN.
ADMIN_GOOGLE_SUBS=

# --- Deployment (phase 8) ---
DOMAIN=api.example.duckdns.org     # used by Caddy for TLS


# ---------------------------------------------------------------------------
# client/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Feature flags. Both default to off when unset; set one to "true" to turn it on.
# Nothing in the UI promises what the running build cannot do, so these also switch the
# wording (client/lib/copy.ts), not just the controls.
#
NEXT_PUBLIC_FEATURE_OCR=true          # phase 4: accept photos and scanned PDFs
# NEXT_PUBLIC_FEATURE_SIGNIN=true     # phase 7c: Sign in with Google, My reports, trends

# Optional. The footer's GitHub link is hidden when this is unset.
# NEXT_PUBLIC_REPO_URL=https://github.com/you/medi-scan
