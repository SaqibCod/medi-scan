# Medi-Scan configuration
#
# Copy to `.env` and fill in. Never commit `.env`.
# The variables here are exactly those defined in docs/plan.md section 10.
#
# Phase 1 (foundation) only reads DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD
# and ALLOWED_ORIGIN. The rest are declared now so the file matches the design
# doc, and are picked up by the phase that needs them.

# --- LLM provider (phase 2) ---
LLM_PROVIDER=gemini                # gemini | openai
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
OPENAI_API_KEY=                    # optional, leave empty to disable
OPENAI_CHAT_MODEL=gpt-5-mini

# --- Embeddings (phase 5) ---
# Fixed once chosen: changing the model means re-embedding every biomarker page
# and migrating the pgvector column. EMBEDDING_DIMENSIONS must match that column.
EMBEDDING_PROVIDER=gemini          # fixed once chosen
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768           # must match the pgvector column

# --- Database ---
# Port 5433, not the default 5432: the local compose file publishes there so it
# does not collide with a natively installed Postgres.
DATABASE_URL=jdbc:postgresql://localhost:5433/mediscan
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- CORS ---
ALLOWED_ORIGIN=http://localhost:3000

# --- Limits and cost control ---
RATE_LIMIT_UPLOADS_PER_HOUR=10
# Per IP, for POST /api/sessions (contract 1.6). Read by phase 1.
RATE_LIMIT_SESSIONS_PER_HOUR=20
GLOBAL_DAILY_LLM_CALLS=500

# --- Retention ---
RETENTION_HOURS=24                 # guest sessions
USER_RETENTION_DAYS=30             # signed-in users' reports
INACTIVE_ACCOUNT_DAYS=180

# --- Google sign-in (phase 6) ---
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com   # public, not a secret

# --- Access and refresh tokens (phase 6) ---
# Generate each key with: openssl rand -base64 32
# Never reuse a key between local and production.
JWT_SIGNING_KEYS=k2026a:REPLACE_WITH_BASE64_32_BYTES   # comma-separated kid:key pairs
JWT_CURRENT_KID=k2026a
JWT_ISSUER=medi-scan
# The `aud` claim on access tokens, which the resource server verifies (contract 2.3).
JWT_AUDIENCE=medi-scan-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_FAMILY_MAX_DAYS=30

# --- Admin (phase 6) ---
# Comma-separated Google `sub` ids. This is the only way to grant ADMIN.
ADMIN_GOOGLE_SUBS=

# --- Deployment (phase 8) ---
DOMAIN=api.example.duckdns.org     # used by Caddy for TLS


# ---------------------------------------------------------------------------
# client/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
